-- Shared pgTAP helpers. Every test file includes this with `\ir _helpers.psql` right after `begin;`.
-- Everything here is created inside the test's transaction and rolled back with it, so nothing
-- reaches a real database. (pg_prove only runs *.sql files, so this file is never run on its own.)
--
--   select tests.create_user('dale');              -- auth user + active profile, returns uuid
--   select tests.create_user('mod', 'moderator');  -- app_metadata.role = moderator
--   select tests.id('dale');                       -- uuid of a user created above
--   select tests.act_as('dale');                   -- role authenticated, JWT claims for dale
--   select tests.act_as_anon();                    -- role anon, no user
--   select tests.act_as_service();                 -- role service_role (Edge Functions)
--   select tests.reset_role();                     -- back to the postgres superuser
--   select tests.world();                          -- owner, reader, outsider, blocked, blocker, moderator
--   select tests.make_jar('owner', 'everyone', published => true);   -- jar for today in its zone
--   select tests.make_moment(jar, 'morning', 'live');                -- moment in a given status

set local client_min_messages = warning;
create extension if not exists pgtap with schema extensions;

create schema if not exists tests;
grant usage on schema tests to anon, authenticated, service_role;

create table tests.users (name text primary key, id uuid not null unique, app_role text);
grant select on tests.users to anon, authenticated, service_role;

create function tests.create_user(p_name text, p_app_role text default null, p_tz text default 'Asia/Manila')
returns uuid language plpgsql as $$
declare uid uuid := gen_random_uuid();
begin
  insert into auth.users (instance_id, id, aud, role, email, encrypted_password, email_confirmed_at,
                          raw_app_meta_data, raw_user_meta_data, created_at, updated_at)
  values ('00000000-0000-0000-0000-000000000000', uid, 'authenticated', 'authenticated',
          p_name || '@tests.pickld.test', '', now(),
          jsonb_strip_nulls(jsonb_build_object('provider', 'email', 'role', p_app_role)), '{}', now(), now());
  insert into public.profiles (id, username, display_name, birthday, home_tz)
  values (uid, 't_' || left(p_name, 18), initcap(p_name), date '1995-05-05', p_tz);
  insert into tests.users (name, id, app_role) values (p_name, uid, p_app_role);
  return uid;
end $$;

create function tests.id(p_name text) returns uuid language sql stable as $$
  select id from tests.users where name = p_name
$$;

create function tests.act_as(p_name text) returns void language plpgsql as $$
declare
  u tests.users;
begin
  select * into u from tests.users where name = p_name;
  if u.id is null then raise exception 'tests.act_as: unknown user %', p_name; end if;
  perform set_config('role', 'authenticated', true);
  perform set_config('request.jwt.claims', jsonb_build_object(
    'sub', u.id, 'role', 'authenticated', 'aud', 'authenticated',
    'app_metadata', jsonb_strip_nulls(jsonb_build_object('provider', 'email', 'role', u.app_role)))::text, true);
end $$;

create function tests.act_as_anon() returns void language plpgsql as $$
begin
  perform set_config('role', 'anon', true);
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
end $$;

create function tests.act_as_service() returns void language plpgsql as $$
begin
  perform set_config('role', 'service_role', true);
  perform set_config('request.jwt.claims', '{"role":"service_role"}', true);
end $$;

create function tests.reset_role() returns void language plpgsql as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end $$;

grant execute on all functions in schema tests to anon, authenticated, service_role;

-- The standard cast for visibility tests:
--   owner     the author whose content is tested
--   reader    follows owner
--   outsider  signed in, no relationship
--   blocked   owner blocked them (they used to read owner)
--   blocker   blocked owner (they used to read owner)
--   moderator app_metadata.role = moderator, no relationship
create function tests.world() returns void language plpgsql as $$
begin
  perform tests.create_user('owner');
  perform tests.create_user('reader');
  perform tests.create_user('outsider');
  perform tests.create_user('blocked');
  perform tests.create_user('blocker');
  perform tests.create_user('moderator', 'moderator');
  insert into public.follows (reader_id, author_id) values
    (tests.id('reader'), tests.id('owner')),
    (tests.id('blocked'), tests.id('owner')),
    (tests.id('blocker'), tests.id('owner'));
  insert into public.blocks (blocker_id, blocked_id) values
    (tests.id('owner'), tests.id('blocked')),
    (tests.id('blocker'), tests.id('owner'));
end $$;

-- A jar for "today" (or today minus p_days_ago) in p_tz, inserted as the superuser.
create function tests.make_jar(p_owner text, p_visibility jar_visibility default 'readers',
                               published boolean default false, p_days_ago int default 0,
                               p_tz text default 'Asia/Manila')
returns uuid language plpgsql as $$
declare jid uuid;
begin
  insert into public.jars (user_id, local_date, tz, visibility, published_at)
  values (tests.id(p_owner), (now() at time zone p_tz)::date - p_days_ago, p_tz, p_visibility,
          case when published then now() end)
  returning id into jid;
  return jid;
end $$;

-- A moment in p_status. Inserted through the normal trigger path, then moved to the
-- requested status as the server (service_role) would do it.
create function tests.make_moment(p_jar uuid, p_slot slot, p_status moment_status default 'live',
                                  p_private boolean default false)
returns uuid language plpgsql as $$
declare mid uuid;
begin
  insert into public.moments (jar_id, user_id, slot, photo_path, thumb_path, is_private, status)
  select p_jar, j.user_id, p_slot, 'p/' || gen_random_uuid(), 't/' || gen_random_uuid(), p_private, 'checking'
  from public.jars j where j.id = p_jar
  returning id into mid;
  if p_status <> 'checking' then
    perform set_config('request.jwt.claims', '{"role":"service_role"}', true);
    update public.moments set status = p_status where id = mid;
    perform set_config('request.jwt.claims', '', true);
  end if;
  return mid;
end $$;
