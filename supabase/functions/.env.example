# Secrets for Edge Functions. Locally: copy to supabase/functions/.env (git-ignored). Staging/production:
# `supabase secrets set NAME=value`. SUPABASE_URL and SUPABASE_ANON_KEY are provided by the runtime.
# Photo bucket (R2: endpoint https://<account>.r2.cloudflarestorage.com, region auto; locally the
# STORAGE_S3_URL, S3_PROTOCOL_REGION and S3_PROTOCOL_ACCESS_KEY_* values from `supabase status -o env`).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Shared with the photo Worker (workers/photos): signs 15-minute photo tokens (fn:photo-urls).
PHOTO_TOKEN_SECRET=
# Optional crash reporting; empty means off.
SENTRY_DSN=
APP_ENV=local
