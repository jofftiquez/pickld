# Secrets for Edge Functions. Locally: copy to supabase/functions/.env (git-ignored). Staging/production:
# `supabase secrets set NAME=value`. SUPABASE_URL and SUPABASE_ANON_KEY are provided by the runtime.
# Photo bucket (R2: endpoint https://<account>.r2.cloudflarestorage.com, region auto; locally the
# STORAGE_S3_URL, S3_PROTOCOL_REGION and S3_PROTOCOL_ACCESS_KEY_* values from `supabase status -o env`).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Photo Worker (workers/photos): its origin, and the secret shared with it that signs 15-minute photo
# tokens (fn:photo-urls). Locally http://127.0.0.1:55430 and the value in workers/photos/.env.
PHOTO_BASE_URL=
PHOTO_TOKEN_SECRET=
# Key for the keyed HMAC-SHA256 contact hashes (fn:contacts-match, D-4): at least 32 random characters,
# e.g. `openssl rand -hex 32`. Changing it means truncating public.contact_hashes (calls refill it).
CONTACT_HASH_SECRET=
# fn:send-push: the x-push-secret header a Supabase Cron job sends every minute (at least 32 random
# characters, e.g. `openssl rand -hex 32`), and an Expo access token, needed only if the Expo project
# enforces push security (empty is fine).
PUSH_CRON_SECRET=
EXPO_ACCESS_TOKEN=
# Optional crash reporting; empty means off.
SENTRY_DSN=
APP_ENV=local
