# Secrets for Edge Functions. Locally: copy to supabase/functions/.env (git-ignored). Staging/production:
# `supabase secrets set NAME=value`. SUPABASE_URL and SUPABASE_ANON_KEY are provided by the runtime.
# Photo bucket (R2: endpoint https://<account>.r2.cloudflarestorage.com, region auto; locally the
# STORAGE_S3_URL, S3_PROTOCOL_REGION and S3_PROTOCOL_ACCESS_KEY_* values from `supabase status -o env`).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only where functions can't reach S3_ENDPOINT themselves: locally the same URL with host.docker.internal
# in place of 127.0.0.1 (the Edge runtime is a container). Leave empty with R2.
S3_INTERNAL_ENDPOINT=
# Photo Worker (workers/photos): its origin, and the secret shared with it that signs 15-minute photo
# tokens (fn:photo-urls). Locally http://127.0.0.1:55430 and the value in workers/photos/.env.
PHOTO_BASE_URL=
PHOTO_TOKEN_SECRET=
# Key for the keyed HMAC-SHA256 contact hashes (fn:contacts-match, D-4): at least 32 random characters,
# e.g. `openssl rand -hex 32`. Changing it means truncating public.contact_hashes (calls refill it).
CONTACT_HASH_SECRET=
# fn:send-push: the x-push-secret header a Supabase Cron job sends every minute (at least 32 random
# characters, e.g. `openssl rand -hex 32`), and an Expo access token, needed only if the Expo project
# enforces push security (empty is fine).
PUSH_CRON_SECRET=
EXPO_ACCESS_TOKEN=
# fn:account-jobs: the x-jobs-secret header a Supabase Cron job sends every few minutes to run data
# exports and account deletions (at least 32 random characters, e.g. `openssl rand -hex 32`).
ACCOUNT_JOBS_SECRET=
# fn:revenuecat-webhook (M6-01): RevenueCat's dashboard sends `Authorization: Bearer <REVENUECAT_WEBHOOK_SECRET>`
# (at least 32 random characters, e.g. `openssl rand -hex 32`), and the function reads verified purchases with
# the project's secret API key (v1). REVENUECAT_API_URL is only for local tests against a stub; leave it empty.
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_SECRET_KEY=
REVENUECAT_API_URL=
# fn:moderate, the full photo check (M2-20, D-41). Empty OPENAI_API_KEY means auto-approve (D-22, local only;
# production refuses to start without it). OPENAI_VISION_MODEL is the borderline second opinion (D-13; "off"
# asks none). CSAM_MATCHER is hash-list, a local stand-in that production refuses until an approved matcher
# (PhotoDNA) is added; CSAM_HASH_LIST is its comma-separated SHA-256 list.
# OPENAI_BASE_URL is only for local stand-ins; leave it empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_VISION_MODEL=
CSAM_MATCHER=hash-list
CSAM_HASH_LIST=
# Optional crash reporting; empty means off.
SENTRY_DSN=
APP_ENV=local
# fn:waitlist-join: the x-waitlist-secret header pickld.me's server sends (at least 32 random characters, e.g.
# `openssl rand -hex 32`); apps/web/.env.local gets the same value. It also keys the stored IP hashes.
WAITLIST_SECRET=
