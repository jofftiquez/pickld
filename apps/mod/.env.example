# Copy to .env.local (git-ignored). Read on the server only.
# Supabase project URL and its anon (publishable) key. Never a service key (AGENTS rule 2): moderators sign
# in with their own account, and Postgres (RLS, is_moderator()) and fn:mod-action check the moderator role.
# Locally: http://127.0.0.1:55421 and the ANON_KEY from `supabase status`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: the PostHog insight for upload failures (docs/runbooks/alerts.md). Overview links to it.
POSTHOG_UPLOADS_URL=
