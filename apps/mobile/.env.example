# Copy to .env. Only EXPO_PUBLIC_ values are bundled, so only public values belong here:
# the Supabase URL and the anon (publishable) key. Never put a service key in the app (AGENTS rule 2).
# Defaults point at local Supabase (`supabase start`); use the anon key it prints.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
