{
  "expo": {
    "name": "Pickld",
    "slug": "pickld",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "pickld",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "me.pickld.app",
      "supportsTablet": false
    },
    "android": {
      "package": "me.pickld.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
