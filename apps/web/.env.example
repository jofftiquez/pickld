# Copy to .env.local (git-ignored). Read on the server only; nothing here is sent to the browser.
# Supabase project URL and its anon (publishable) key. Never a service key (AGENTS rule 2): the pages get
# their data and photo URLs from fn:public-page, which only signs what public_profile/public_jar return.
# Locally: http://127.0.0.1:55421 and the ANON_KEY from `supabase status`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Store listings for the App Store / Google Play buttons. Empty App Store URL hides that button until
# the app is listed; Google Play defaults to the me.pickld.app listing.
APP_STORE_URL=
PLAY_STORE_URL=
# The waitlist form (pickld.me home page) posts to fn:waitlist-join on SUPABASE_URL with this shared secret,
# the same value as WAITLIST_SECRET in supabase/functions/.env. Empty: the form answers "try again later".
WAITLIST_SECRET=
# Public origin used in link previews (og:url, og:image). Defaults to https://pickld.me.
SITE_URL=
# Universal links / app links (M4-15). Apple Developer Team ID (10 characters), and the SHA-256 of the
# Play app signing certificate (AA:BB:… form; comma-separate several). Each file 404s until set.
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
