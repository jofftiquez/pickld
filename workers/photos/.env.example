# Copy to .env for `deno task dev` and `deno task seed`. Never commit .env.
# Signing secret shared with fn:photo-urls (32+ random characters, e.g. `openssl rand -base64 48`).
# In Cloudflare: `wrangler secret put PHOTO_TOKEN_SECRET`; in Supabase: `supabase secrets set PHOTO_TOKEN_SECRET=…`.
PHOTO_TOKEN_SECRET=
# Optional: the local S3 stand-in is read from `supabase status` when these are empty.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
